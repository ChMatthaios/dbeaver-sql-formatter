<Application x:Class="SqlFormatterApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Semantic brushes. ThemeService swaps these at runtime. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#20252D" />
    <SolidColorBrush x:Key="TopBarBrush" Color="#252B34" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A303A" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#303743" />
    <SolidColorBrush x:Key="EditorBrush" Color="#272D36" />
    <SolidColorBrush x:Key="EditorOutputBrush" Color="#252B33" />
    <SolidColorBrush x:Key="BorderBrush" Color="#46505D" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E9EF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7CED8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA5B3" />
    <SolidColorBrush x:Key="ControlBrush" Color="#343C48" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3C4654" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5B7DBA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6A8AC6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#4C627E" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#7F8996" />

    <!--
      Generic SQL Formatter icon: a calm blue rounded tile, three formatted
      code lines and a small sparkle. DrawingImage is vector-based, so the same
      resource stays crisp in the title bar and on the Windows taskbar.
    -->
    <DrawingImage x:Key="AppIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#5578B6">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="1,1,30,30" RadiusX="6" RadiusY="6" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#F5F7FA" Geometry="M 7,8 H 23 V 11 H 7 Z M 10,14 H 25 V 17 H 10 Z M 7,20 H 20 V 23 H 7 Z" />
          <GeometryDrawing Brush="#A9CBFF" Geometry="M 5,8 H 7 V 11 H 5 Z M 7,14 H 10 V 17 H 7 Z M 5,20 H 7 V 23 H 5 Z" />
          <GeometryDrawing Brush="#FFFFFF" Geometry="M 24,20 L 25,23 L 28,24 L 25,25 L 24,28 L 23,25 L 20,24 L 23,23 Z" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!--
      Fully-owned ComboBox template. The stock Windows template can ignore WPF
      Foreground resources for the closed selection box, causing unreadable
      values in dark mode.
    -->
    <ControlTemplate x:Key="ThemedComboBoxTemplate" TargetType="{x:Type ComboBox}">
      <Grid SnapsToDevicePixels="True">
        <ToggleButton x:Name="ToggleButton"
                      Focusable="False"
                      ClickMode="Press"
                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
          <ToggleButton.Template>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border x:Name="OuterBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="3">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="1"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1,0,0,0" />
                  <Path Grid.Column="1"
                        Width="9"
                        Height="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource TextSecondaryBrush}"
                        Data="M 0 0 L 4.5 5 L 9 0 Z" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </ToggleButton.Template>
        </ToggleButton>

        <ContentPresenter x:Name="ContentSite"
                          Margin="9,0,34,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          IsHitTestVisible="False"
                          RecognizesAccessKey="True"
                          Content="{TemplateBinding SelectionBoxItem}"
                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                          TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />

        <Popup x:Name="PART_Popup"
               Placement="Bottom"
               AllowsTransparency="True"
               Focusable="False"
               IsOpen="{TemplateBinding IsDropDownOpen}"
               PopupAnimation="Fade">
          <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                  Margin="0,2,0,0"
                  Padding="1"
                  Background="{DynamicResource ControlBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="3">
            <ScrollViewer CanContentScroll="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
            </ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource DisabledTextBrush}" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Application.Resources>
</Application>