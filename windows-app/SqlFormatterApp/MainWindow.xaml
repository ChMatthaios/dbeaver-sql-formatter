<Window x:Class="SqlFormatterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Formatter"
        Width="1320"
        Height="800"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox" x:Key="EditorTextBox">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="AcceptsTab" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#111827" Padding="12,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Open" Click="Open_Click" />
          <Button x:Name="FormatButton" Content="Format  Ctrl+Enter" Click="Format_Click" Background="#DBEAFE" />
          <Button Content="Copy Output" Click="CopyOutput_Click" />
          <Button Content="Replace Input" Click="ReplaceInput_Click" />
          <Button Content="Save Output" Click="SaveOutput_Click" />
          <Button Content="Clear" Click="Clear_Click" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="Max width" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="WidthBox" Width="54" Height="30" VerticalContentAlignment="Center" TextAlignment="Center" Margin="0,0,14,0" />
          <Border Background="#1F2937" CornerRadius="4" Padding="10,6">
            <TextBlock x:Name="DialectText" Text="Dialect: Auto" Foreground="#F9FAFB" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel>
              <TextBlock Text="Input" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" />
              <TextBlock x:Name="InputStatsText" DockPanel.Dock="Right" Foreground="#6B7280" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <TextBox x:Name="InputBox" Grid.Row="1" Style="{StaticResource EditorTextBox}" TextChanged="InputBox_TextChanged" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel>
              <TextBlock Text="Formatted Output" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" />
              <TextBlock x:Name="OutputStatsText" DockPanel.Dock="Right" Foreground="#6B7280" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <TextBox x:Name="OutputBox" Grid.Row="1" Style="{StaticResource EditorTextBox}" IsReadOnly="True" Background="#FCFCFD" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#E5E7EB" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="12,0">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="#374151" />
        <TextBlock DockPanel.Dock="Right" Text="DB2 • PostgreSQL • T-SQL • Oracle / PL-SQL • SPARQL" VerticalAlignment="Center" Foreground="#6B7280" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
