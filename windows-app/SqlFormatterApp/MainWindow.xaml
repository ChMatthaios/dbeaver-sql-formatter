<Window x:Class="SqlFormatterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Formatter"
        Width="1700"
        Height="900"
        MinWidth="1280"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#E5E7EB"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="TextBox" x:Key="EditorTextBox">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="AcceptsTab" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Background" Value="#0F172A" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="CaretBrush" Value="#F8FAFC" />
      <Setter Property="SelectionBrush" Value="#334155" />
      <Setter Property="SelectionTextBrush" Value="#F8FAFC" />
    </Style>

    <Style TargetType="TextBox" x:Key="SettingTextBox">
      <Setter Property="Height" Value="31" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#0B1324" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="CaretBrush" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="SelectionBrush" Value="#334155" />
    </Style>

    <Style TargetType="ComboBox" x:Key="SettingComboBox">
      <Setter Property="Height" Value="31" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Background" Value="#0B1324" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#0F172A" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="Expander" x:Key="SettingExpander">
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="IsExpanded" Value="False" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Open" Click="Open_Click" />
          <Button x:Name="FormatButton"
                  Content="Format  Ctrl+Enter"
                  Click="Format_Click"
                  Background="#2563EB"
                  BorderBrush="#3B82F6"
                  Foreground="#FFFFFF" />
          <Button Content="Copy Output" Click="CopyOutput_Click" />
          <Button Content="Replace Input" Click="ReplaceInput_Click" />
          <Button Content="Save Output" Click="SaveOutput_Click" />
          <Button Content="Clear" Click="Clear_Click" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="#172033" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,6">
            <TextBlock x:Name="DialectText" Text="Dialect: Auto" Foreground="#CBD5E1" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="370" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#111827" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel>
              <TextBlock Text="Input" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
              <TextBlock x:Name="InputStatsText" DockPanel.Dock="Right" Foreground="#94A3B8" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <TextBox x:Name="InputBox" Grid.Row="1" Style="{StaticResource EditorTextBox}" TextChanged="InputBox_TextChanged" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="84" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="#111827" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel>
              <TextBlock Text="SQL Beautifier" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
              <TextBlock x:Name="SettingsModeText" Text="Custom" DockPanel.Dock="Right" Foreground="#60A5FA" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
              <TextBlock Text="Preset" Foreground="#E2E8F0" FontWeight="SemiBold" />
              <ComboBox x:Name="PresetCombo"
                        Style="{StaticResource SettingComboBox}"
                        SelectionChanged="PresetCombo_SelectionChanged"
                        Margin="0,6,0,10">
                <ComboBoxItem Content="Preserve current formatter" Tag="Preserve" />
                <ComboBoxItem Content="IBM expanded" Tag="IBMExpanded" />
                <ComboBoxItem Content="SQL Prompt-like" Tag="SqlPrompt" />
                <ComboBoxItem Content="Compact" Tag="Compact" />
                <ComboBoxItem Content="Custom" Tag="Custom" />
              </ComboBox>

              <CheckBox x:Name="AdvancedEnabledCheckBox"
                        Content="Enable advanced beautifier"
                        Margin="0,0,0,12" />

              <Expander Header="General" Style="{StaticResource SettingExpander}" IsExpanded="True">
                <StackPanel Margin="8,8,0,6">
                  <TextBlock Text="Max line width" Foreground="#94A3B8" />
                  <TextBox x:Name="WidthBox" Style="{StaticResource SettingTextBox}" TextAlignment="Center" Margin="0,4,0,9" />

                  <TextBlock Text="Indent size" Foreground="#94A3B8" />
                  <ComboBox x:Name="IndentCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,9">
                    <ComboBoxItem Content="2 spaces" Tag="2" />
                    <ComboBoxItem Content="4 spaces" Tag="4" />
                  </ComboBox>

                  <TextBlock Text="Keyword casing" Foreground="#94A3B8" />
                  <ComboBox x:Name="KeywordCasingCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,9">
                    <ComboBoxItem Content="UPPERCASE" Tag="Uppercase" />
                    <ComboBoxItem Content="lowercase" Tag="Lowercase" />
                    <ComboBoxItem Content="Preserve input" Tag="Preserve" />
                  </ComboBox>

                  <CheckBox x:Name="PreserveCommentsCheckBox" Content="Preserve comment line boundaries" />
                </StackPanel>
              </Expander>

              <Expander Header="Parentheses" Style="{StaticResource SettingExpander}">
                <StackPanel Margin="8,8,0,6">
                  <TextBlock Text="Function name → (" Foreground="#94A3B8" />
                  <ComboBox x:Name="FunctionParenSpaceCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="COUNT(...)" Tag="NoSpace" />
                    <ComboBoxItem Content="COUNT (...)" Tag="Space" />
                  </ComboBox>

                  <TextBlock Text="Inside parentheses" Foreground="#94A3B8" />
                  <ComboBox x:Name="InsideParenCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="(value)" Tag="NoSpace" />
                    <ComboBoxItem Content="( value )" Tag="Space" />
                  </ComboBox>

                  <TextBlock Text="Subquery opening" Foreground="#94A3B8" />
                  <ComboBox x:Name="SubqueryOpeningCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="(SELECT ..." Tag="SameLine" />
                    <ComboBoxItem Content="( ↵ SELECT ..." Tag="NewLine" />
                  </ComboBox>

                  <TextBlock Text="Subquery closing" Foreground="#94A3B8" />
                  <ComboBox x:Name="SubqueryClosingCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="... ) same line" Tag="SameLine" />
                    <ComboBoxItem Content="... ↵ )" Tag="NewLine" />
                  </ComboBox>

                  <TextBlock Text="CTE AS parenthesis" Foreground="#94A3B8" />
                  <ComboBox x:Name="CteParenCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,0">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="AS (SELECT ..." Tag="SameLine" />
                    <ComboBoxItem Content="AS ↵ ( ↵ SELECT ..." Tag="NewLine" />
                  </ComboBox>
                </StackPanel>
              </Expander>

              <Expander Header="Lists" Style="{StaticResource SettingExpander}">
                <StackPanel Margin="8,8,0,6">
                  <TextBlock Text="SELECT list" Foreground="#94A3B8" />
                  <ComboBox x:Name="SelectListCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8" />

                  <TextBlock Text="GROUP BY list" Foreground="#94A3B8" />
                  <ComboBox x:Name="GroupByListCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8" />

                  <TextBlock Text="ORDER BY list" Foreground="#94A3B8" />
                  <ComboBox x:Name="OrderByListCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8" />

                  <TextBlock Text="UPDATE SET list" Foreground="#94A3B8" />
                  <ComboBox x:Name="UpdateSetListCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8" />

                  <TextBlock Text="INSERT column list" Foreground="#94A3B8" />
                  <ComboBox x:Name="InsertColumnsListCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8" />

                  <TextBlock Text="VALUES list" Foreground="#94A3B8" />
                  <ComboBox x:Name="ValuesListCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8" />

                  <TextBlock Text="IN (...) list" Foreground="#94A3B8" />
                  <ComboBox x:Name="InListCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8" />

                  <TextBlock Text="Function arguments" Foreground="#94A3B8" />
                  <ComboBox x:Name="FunctionArgsListCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8" />

                  <TextBlock Text="Comma style" Foreground="#94A3B8" />
                  <ComboBox x:Name="CommaStyleCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="Trailing: item," Tag="Trailing" />
                    <ComboBoxItem Content="Leading: , item" Tag="Leading" />
                  </ComboBox>

                  <TextBlock Text="Continuation indentation" Foreground="#94A3B8" />
                  <ComboBox x:Name="ContinuationIndentCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,0">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="Align to first item" Tag="Align" />
                    <ComboBoxItem Content="Indent one level" Tag="Indent" />
                  </ComboBox>
                </StackPanel>
              </Expander>

              <Expander Header="Clauses &amp; joins" Style="{StaticResource SettingExpander}">
                <StackPanel Margin="8,8,0,6">
                  <TextBlock Text="Major clause alignment" Foreground="#94A3B8" />
                  <ComboBox x:Name="ClauseAlignmentCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="IBM right-aligned grid" Tag="IBM" />
                    <ComboBoxItem Content="Left aligned" Tag="Left" />
                    <ComboBoxItem Content="Indented" Tag="Indented" />
                  </ComboBox>

                  <TextBlock Text="AND / OR position" Foreground="#94A3B8" />
                  <ComboBox x:Name="BooleanPositionCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="Leading" Tag="Leading" />
                    <ComboBoxItem Content="Trailing" Tag="Trailing" />
                  </ComboBox>

                  <TextBlock Text="JOIN layout" Foreground="#94A3B8" />
                  <ComboBox x:Name="JoinLayoutCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="Each JOIN on new line" Tag="EachNewLine" />
                    <ComboBoxItem Content="Compact when it fits" Tag="CompactWhenPossible" />
                  </ComboBox>

                  <TextBlock Text="ON clause" Foreground="#94A3B8" />
                  <ComboBox x:Name="OnClauseCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="Same line as JOIN" Tag="SameLine" />
                    <ComboBoxItem Content="New line" Tag="NewLine" />
                  </ComboBox>

                  <TextBlock Text="CTE header" Foreground="#94A3B8" />
                  <ComboBox x:Name="CteLayoutCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="Compact name + AS" Tag="CompactHeader" />
                    <ComboBoxItem Content="Expanded name / AS" Tag="ExpandedHeader" />
                  </ComboBox>

                  <CheckBox x:Name="BlankLineBetweenCtesCheckBox" Content="Blank line between CTEs" />
                </StackPanel>
              </Expander>

              <Expander Header="CASE expressions" Style="{StaticResource SettingExpander}">
                <StackPanel Margin="8,8,0,6">
                  <TextBlock Text="CASE style" Foreground="#94A3B8" />
                  <ComboBox x:Name="CaseStyleCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="Always multiline where safe" Tag="Multiline" />
                    <ComboBoxItem Content="Compact short CASE" Tag="CompactShort" />
                  </ComboBox>

                  <TextBlock Text="THEN result" Foreground="#94A3B8" />
                  <ComboBox x:Name="ThenResultCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="Same line" Tag="SameLine" />
                    <ComboBoxItem Content="New line" Tag="NewLine" />
                  </ComboBox>

                  <TextBlock Text="ELSE result" Foreground="#94A3B8" />
                  <ComboBox x:Name="ElseResultCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,0">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="Same line" Tag="SameLine" />
                    <ComboBoxItem Content="New line" Tag="NewLine" />
                  </ComboBox>
                </StackPanel>
              </Expander>

              <Expander Header="Spacing" Style="{StaticResource SettingExpander}">
                <StackPanel Margin="8,8,0,6">
                  <TextBlock Text="Comparison operators" Foreground="#94A3B8" />
                  <ComboBox x:Name="ComparisonSpacingCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,8">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content="A = B" Tag="Spaced" />
                    <ComboBoxItem Content="A=B" Tag="Tight" />
                  </ComboBox>

                  <TextBlock Text="After comma" Foreground="#94A3B8" />
                  <ComboBox x:Name="AfterCommaCombo" Style="{StaticResource SettingComboBox}" Margin="0,4,0,0">
                    <ComboBoxItem Content="Preserve" Tag="Preserve" />
                    <ComboBoxItem Content=", value" Tag="Space" />
                    <ComboBoxItem Content=",value" Tag="NoSpace" />
                  </ComboBox>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" Background="#0B1324" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="SettingsSummaryText"
                         Foreground="#94A3B8"
                         FontSize="10"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Apply" Click="ApplySettings_Click" Margin="0" Background="#1D4ED8" BorderBrush="#2563EB" Foreground="#FFFFFF" />
                <Button Grid.Column="2" Content="Reset" Click="ResetSettings_Click" Margin="0" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="4" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#111827" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel>
              <TextBlock Text="Formatted Output" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
              <TextBlock x:Name="OutputStatsText" DockPanel.Dock="Right" Foreground="#94A3B8" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <TextBox x:Name="OutputBox" Grid.Row="1" Style="{StaticResource EditorTextBox}" IsReadOnly="True" Background="#0B1324" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="12,0">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="#CBD5E1" />
        <TextBlock DockPanel.Dock="Right"
                   Text="DB2 • PostgreSQL • T-SQL • Oracle / PL-SQL • SPARQL"
                   VerticalAlignment="Center"
                   Foreground="#64748B" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
